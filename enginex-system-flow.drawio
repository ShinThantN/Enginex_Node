<mxfile host="app.diagrams.net" modified="2026-08-02T00:00:00.000Z" agent="Codex" version="26.0.14">
  <diagram id="enginex-system-flow" name="Enginex actual system flow">
    <mxGraphModel dx="1800" dy="2600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Enginex_Node — Actual implementation flow (repository state: unresolved merge)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="210" y="10" width="1180" height="30" as="geometry"/></mxCell>

        <mxCell id="g_start" value="1. Startup and routing" style="swimlane;html=1;horizontal=1;startSize=26;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1510" height="250" as="geometry"/></mxCell>
        <mxCell id="s1" value="npm run dev&#xa;tsx watch src/server.ts" style="shape=process;html=1;whiteSpace=wrap;rounded=1" vertex="1" parent="g_start"><mxGeometry x="30" y="50" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="s2" value="src/server.ts&#xa;contains unresolved Git merge markers" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="g_start"><mxGeometry x="280" y="50" width="205" height="55" as="geometry"/></mxCell>
        <mxCell id="d_start" value="TypeScript&#xa;can parse file?" style="shape=rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="g_start"><mxGeometry x="560" y="40" width="115" height="75" as="geometry"/></mxCell>
        <mxCell id="s_fail" value="Actual result: startup stops&#xa;tsc reports merge conflict markers&#xa;No HTTP server is running" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="g_start"><mxGeometry x="760" y="40" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="s_alt" value="Conflicted alternatives in code:&#xa;src/index.ts mounts /v1/api and listens 3000;&#xa;src/server.ts alternatives mount /api" style="shape=note;html=1;whiteSpace=wrap;fillColor=#f5f5f5" vertex="1" parent="g_start"><mxGeometry x="1080" y="35" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="s_defined" value="The following route/service flows are implemented in source&#xa;but unreachable until the merge is resolved." style="shape=note;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="g_start"><mxGeometry x="390" y="155" width="620" height="45" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="g_start" source="s1" target="s2" style="endArrow=block;html=1"/><mxCell id="e2" edge="1" parent="g_start" source="s2" target="d_start" style="endArrow=block;html=1"/><mxCell id="e3" value="No" edge="1" parent="g_start" source="d_start" target="s_fail" style="endArrow=block;html=1"/><mxCell id="e4" value="conflicted variants" edge="1" parent="g_start" source="d_start" target="s_alt" style="endArrow=open;dashed=1;html=1"/>

        <mxCell id="g_auth" value="2. Authentication, email verification, and token lifecycle (implemented routes)" style="swimlane;html=1;horizontal=1;startSize=26;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1510" height="410" as="geometry"/></mxCell>
        <mxCell id="a_req" value="POST /api/auth/register&#xa;{name,email,password,role}" style="shape=parallelogram;html=1;whiteSpace=wrap" vertex="1" parent="g_auth"><mxGeometry x="25" y="45" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="a_val" value="Zod CreateUserSchema&#xa;name ≥3, valid email, password ≥6,&#xa;role CLIENT | ENGINEER | COMPANY" style="shape=process;html=1;whiteSpace=wrap;rounded=1" vertex="1" parent="g_auth"><mxGeometry x="255" y="35" width="235" height="75" as="geometry"/></mxCell>
        <mxCell id="a_valid" value="Valid?" style="shape=rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc" vertex="1" parent="g_auth"><mxGeometry x="535" y="38" width="90" height="70" as="geometry"/></mxCell>
        <mxCell id="a_422" value="422 Validation Failed" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#f8cecc" vertex="1" parent="g_auth"><mxGeometry x="670" y="40" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="a_create" value="Auth service&#xa;bcrypt hash password;&#xa;INSERT User (PENDING_VERIFICATION)" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_auth"><mxGeometry x="670" y="135" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="a_dup" value="Unique email conflict?&#xa;P2002 → 409" style="shape=rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc" vertex="1" parent="g_auth"><mxGeometry x="910" y="140" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="a_otp" value="OTP service&#xa;CSPRNG numeric code → bcrypt hash;&#xa;UPDATE User OTP hash/expiry/sent time" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_auth"><mxGeometry x="1060" y="130" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="a_email" value="Resend email service&#xa;render HTML template + inline logo&#xa;send OTP email" style="shape=cloud;html=1;whiteSpace=wrap;fillColor=#e1d5e7" vertex="1" parent="g_auth"><mxGeometry x="1310" y="135" width="160" height="75" as="geometry"/></mxCell>
        <mxCell id="a_regok" value="201: user created; verification required" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4" vertex="1" parent="g_auth"><mxGeometry x="1060" y="250" width="210" height="45" as="geometry"/></mxCell>
        <mxCell id="a_verify" value="POST /verify-email or /resend-otp&#xa;validate email + OTP / cooldown&#xa;verify bcrypt OTP &amp; expiry&#xa;UPDATE User: emailVerified=true, ACTIVE, clear OTP&#xa;errors: 400 invalid, 410 expired, 429 cooldown" style="shape=process;html=1;whiteSpace=wrap;rounded=1" vertex="1" parent="g_auth"><mxGeometry x="30" y="270" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="a_login" value="POST /login&#xa;Zod → SELECT User by email → bcrypt compare&#xa;verified? No → 403" style="shape=process;html=1;whiteSpace=wrap;rounded=1" vertex="1" parent="g_auth"><mxGeometry x="470" y="280" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="a_token" value="Success: sign JWT access token (15m)&#xa;Set HTTP-only jwt refresh cookie (7d)&#xa;return accessToken + user" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4" vertex="1" parent="g_auth"><mxGeometry x="800" y="280" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="a_refresh" value="POST /refresh: verify jwt cookie → new access token&#xa;POST /logout: clear jwt cookie&#xa;(RefreshToken database model is not used)" style="shape=process;html=1;whiteSpace=wrap;rounded=1" vertex="1" parent="g_auth"><mxGeometry x="1120" y="275" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="ae1" edge="1" parent="g_auth" source="a_req" target="a_val" style="endArrow=block;html=1"/><mxCell id="ae2" edge="1" parent="g_auth" source="a_val" target="a_valid" style="endArrow=block;html=1"/><mxCell id="ae3" value="No" edge="1" parent="g_auth" source="a_valid" target="a_422" style="endArrow=block;html=1"/><mxCell id="ae4" value="Yes" edge="1" parent="g_auth" source="a_valid" target="a_create" style="endArrow=block;html=1"/><mxCell id="ae5" edge="1" parent="g_auth" source="a_create" target="a_dup" style="endArrow=block;html=1"/><mxCell id="ae6" value="No" edge="1" parent="g_auth" source="a_dup" target="a_otp" style="endArrow=block;html=1"/><mxCell id="ae7" edge="1" parent="g_auth" source="a_otp" target="a_email" style="endArrow=block;html=1"/><mxCell id="ae8" edge="1" parent="g_auth" source="a_email" target="a_regok" style="endArrow=block;html=1"/>

        <mxCell id="g_guard" value="3. Shared protected-request gate" style="swimlane;html=1;horizontal=1;startSize=26;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1510" height="165" as="geometry"/></mxCell>
        <mxCell id="m_req" value="Protected API request&#xa;Authorization: Bearer &lt;access token&gt;" style="shape=parallelogram;html=1;whiteSpace=wrap" vertex="1" parent="g_guard"><mxGeometry x="55" y="55" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="m_auth" value="authenticateUser&#xa;verify JWT; SELECT User id + role;&#xa;assign req.user" style="shape=process;html=1;whiteSpace=wrap;rounded=1" vertex="1" parent="g_guard"><mxGeometry x="345" y="45" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="m_ok" value="Token and user valid?" style="shape=rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc" vertex="1" parent="g_guard"><mxGeometry x="630" y="48" width="115" height="70" as="geometry"/></mxCell>
        <mxCell id="m_401" value="401&#xa;authentication required /&#xa;invalid or expired token" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#f8cecc" vertex="1" parent="g_guard"><mxGeometry x="800" y="52" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="m_role" value="requireRole (where wired)&#xa;ENGINEER / COMPANY / SUPER_ADMIN" style="shape=process;html=1;whiteSpace=wrap;rounded=1" vertex="1" parent="g_guard"><mxGeometry x="1050" y="50" width="210" height="65" as="geometry"/></mxCell>
        <mxCell id="m_403" value="403 Forbidden" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#f8cecc" vertex="1" parent="g_guard"><mxGeometry x="1320" y="55" width="135" height="55" as="geometry"/></mxCell>
        <mxCell id="me1" edge="1" parent="g_guard" source="m_req" target="m_auth" style="endArrow=block;html=1"/><mxCell id="me2" edge="1" parent="g_guard" source="m_auth" target="m_ok" style="endArrow=block;html=1"/><mxCell id="me3" value="No" edge="1" parent="g_guard" source="m_ok" target="m_401" style="endArrow=block;html=1"/><mxCell id="me4" value="Yes" edge="1" parent="g_guard" source="m_ok" target="m_role" style="endArrow=block;html=1"/><mxCell id="me5" value="role fails" edge="1" parent="g_guard" source="m_role" target="m_403" style="endArrow=block;html=1"/>

        <mxCell id="g_client" value="4. Client module (routes are merge-conflicted; service/controller implementation)" style="swimlane;html=1;horizontal=1;startSize=26;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="945" width="1510" height="245" as="geometry"/></mxCell>
        <mxCell id="c_public" value="GET /clients/search&#xa;GET /clients/engineers/:id&#xa;GET /clients/teams/:id&#xa;validate query/id → SELECT profiles&#xa;pagination/search filters → 200 or 400/404" style="shape=process;html=1;whiteSpace=wrap;rounded=1" vertex="1" parent="g_client"><mxGeometry x="35" y="45" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="c_gate" value="Client-only paths&#xa;authenticateUser + intended requireClientRole&#xa;(referenced middleware file is absent)" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#fff2cc" vertex="1" parent="g_client"><mxGeometry x="380" y="55" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="c_profile" value="GET /profile: SELECT User + ClientProfile&#xa;PUT /profile: Zod → UPDATE User + UPSERT ClientProfile" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_client"><mxGeometry x="690" y="55" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="c_fav" value="POST /favorites: validate → SELECT EngineerProfile;&#xa;SELECT existing → INSERT Favorite if absent&#xa;GET /favorites: SELECT Favorites + engineer/user" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_client"><mxGeometry x="1035" y="50" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="c_project" value="POST /projects: Zod validation&#xa;INSERT Project (clientId, status OPEN)&#xa;201 / validation 400" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_client"><mxGeometry x="680" y="165" width="290" height="55" as="geometry"/></mxCell>
        <mxCell id="ce1" edge="1" parent="g_client" source="c_gate" target="c_profile" style="endArrow=block;html=1"/><mxCell id="ce2" edge="1" parent="g_client" source="c_profile" target="c_fav" style="endArrow=block;html=1"/>

        <mxCell id="g_eng" value="5. Engineer module (routes are merge-conflicted)" style="swimlane;html=1;horizontal=1;startSize=26;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="1210" width="1510" height="250" as="geometry"/></mxCell>
        <mxCell id="en_gate" value="Intended gate&#xa;authenticateUser + ENGINEER role" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#fff2cc" vertex="1" parent="g_eng"><mxGeometry x="35" y="75" width="200" height="65" as="geometry"/></mxCell>
        <mxCell id="en_profile" value="GET /profile: SELECT User + EngineerProfile + experience/portfolio&#xa;PUT/PATCH /profile: Zod → UPDATE User + UPSERT EngineerProfile;&#xa;if portfolios supplied: DELETE existing + INSERT replacements transaction" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_eng"><mxGeometry x="290" y="45" width="395" height="115" as="geometry"/></mxCell>
        <mxCell id="en_status" value="PUT /profile/status&#xa;Zod availability → UPSERT EngineerProfile" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_eng"><mxGeometry x="750" y="50" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="en_direct" value="GET /direct-projects&#xa;SELECT projects where selectedEngineer + DIRECT" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_eng"><mxGeometry x="1030" y="50" width="235" height="75" as="geometry"/></mxCell>
        <mxCell id="en_apply" value="POST /projects/:id/apply&#xa;validate → SELECT project; OPEN + PUBLIC + OPEN?&#xa;duplicate application? → INSERT ProjectResponse APPLICATION/PENDING&#xa;errors 404/403/409/422" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_eng"><mxGeometry x="300" y="175" width="400" height="55" as="geometry"/></mxCell>
        <mxCell id="en_companies" value="GET /companies&#xa;SELECT active COMPANY users + TeamProfile" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_eng"><mxGeometry x="780" y="170" width="250" height="55" as="geometry"/></mxCell>
        <mxCell id="ee1" edge="1" parent="g_eng" source="en_gate" target="en_profile" style="endArrow=block;html=1"/>

        <mxCell id="g_feed" value="6. Feed module (most complete end-to-end implementation)" style="swimlane;html=1;horizontal=1;startSize=26;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="20" y="1480" width="1510" height="360" as="geometry"/></mxCell>
        <mxCell id="f_gate" value="All feed paths&#xa;authenticateUser&#xa;then request-specific role/ownership checks" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#fff2cc" vertex="1" parent="g_feed"><mxGeometry x="35" y="125" width="195" height="70" as="geometry"/></mxCell>
        <mxCell id="f_read" value="GET /posts/feed&#xa;validate page/limit/sort → SELECT PUBLIC Posts + author;&#xa;latest or viralScore trending; count → paginated 200&#xa;&#xa;GET /posts/search → SELECT PUBLIC title/content matches + pagination" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_feed"><mxGeometry x="285" y="40" width="325" height="120" as="geometry"/></mxCell>
        <mxCell id="f_post" value="POST /posts (ENGINEER|COMPANY)&#xa;Zod → INSERT Post → 201&#xa;&#xa;PATCH/DELETE /posts/:id&#xa;validate → SELECT owner → 403 if not owner;&#xa;UPDATE or transactional DELETE children + Post" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_feed"><mxGeometry x="675" y="35" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="f_like" value="POST/DELETE /posts/:id/like&#xa;transaction: SELECT Post → INSERT/DELETE PostLike;&#xa;duplicate/not-liked → 409; UPDATE likeCount + viralScore" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_feed"><mxGeometry x="1070" y="40" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="f_comment" value="POST /posts/:id/comments&#xa;transaction: INSERT PostComment; UPDATE commentCount + viralScore&#xa;GET comments: SELECT paginated comments + author&#xa;PATCH/DELETE /comments/:id: owner check → UPDATE or transaction DELETE + decrement/re-score" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_feed"><mxGeometry x="285" y="210" width="450" height="105" as="geometry"/></mxCell>
        <mxCell id="f_score" value="Viral score (pure service)&#xa;(likes×1 + comments×4 + offers×12 + contracts×30)&#xa;/ (hours since created + 2)^1.5&#xa;engagement service can update offer/contract counters; no caller exists" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#e1d5e7" vertex="1" parent="g_feed"><mxGeometry x="820" y="220" width="450" height="95" as="geometry"/></mxCell>
        <mxCell id="fe1" edge="1" parent="g_feed" source="f_gate" target="f_read" style="endArrow=block;html=1"/><mxCell id="fe2" edge="1" parent="g_feed" source="f_gate" target="f_post" style="endArrow=block;html=1"/><mxCell id="fe3" edge="1" parent="g_feed" source="f_gate" target="f_like" style="endArrow=block;html=1"/><mxCell id="fe4" edge="1" parent="g_feed" source="f_like" target="f_score" style="endArrow=block;html=1"/><mxCell id="fe5" edge="1" parent="g_feed" source="f_comment" target="f_score" style="endArrow=block;html=1"/>

        <mxCell id="g_team_admin" value="7. Team and admin modules (both route files are merge-conflicted)" style="swimlane;html=1;horizontal=1;startSize=26;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="20" y="1860" width="1510" height="230" as="geometry"/></mxCell>
        <mxCell id="t_flow" value="Team/company profile&#xa;intended COMPANY gate&#xa;GET /team/profile: SELECT User + TeamProfile&#xa;PATCH /team/profile: raw req.body → UPSERT TeamProfile&#xa;No Zod validation" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_team_admin"><mxGeometry x="80" y="45" width="370" height="105" as="geometry"/></mxCell>
        <mxCell id="ad_gate" value="Admin intended gate&#xa;authenticateUser + SUPER_ADMIN" style="shape=process;html=1;whiteSpace=wrap;rounded=1;fillColor=#fff2cc" vertex="1" parent="g_team_admin"><mxGeometry x="570" y="65" width="210" height="65" as="geometry"/></mxCell>
        <mxCell id="ad_flow" value="Admin users&#xa;GET /users: pagination → SELECT Users + COUNT&#xa;GET /users/:id: validate → SELECT User (404 if absent)&#xa;PATCH/PUT: Zod → UPDATE User&#xa;DELETE: DELETE User (404 if absent)" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#d5e8d4" vertex="1" parent="g_team_admin"><mxGeometry x="880" y="40" width="420" height="115" as="geometry"/></mxCell>
        <mxCell id="ta1" edge="1" parent="g_team_admin" source="ad_gate" target="ad_flow" style="endArrow=block;html=1"/>

        <mxCell id="g_data" value="8. Persistence and external boundary" style="swimlane;html=1;horizontal=1;startSize=26;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="20" y="2110" width="1510" height="200" as="geometry"/></mxCell>
        <mxCell id="db" value="MySQL / Prisma MariaDB adapter&#xa;DATABASE_URL or MYSQL_* configuration&#xa;PrismaClient singleton in shared/config/prisma.ts&#xa;Tables: User/profiles, projects/responses, feed, moderation, etc." style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#dae8fc" vertex="1" parent="g_data"><mxGeometry x="300" y="55" width="410" height="90" as="geometry"/></mxCell>
        <mxCell id="mail" value="External Resend API&#xa;RESEND_API_KEY + EMAIL_FROM&#xa;used only by OTP email service" style="shape=cloud;html=1;whiteSpace=wrap;fillColor=#e1d5e7" vertex="1" parent="g_data"><mxGeometry x="890" y="60" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="de1" value="all service reads/writes" edge="1" parent="g_data" source="db" target="mail" style="endArrow=none;dashed=1;html=1"/>
        <mxCell id="note_frontend" value="No frontend pages, components, navigation, client-side state, or frontend API client exist in this repository." style="shape=note;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="390" y="2340" width="770" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
