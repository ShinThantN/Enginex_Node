# Database
DATABASE_URL="mysql://user:password@127.0.0.1:3307/enginex_db"
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=enginex_db

# Auth / JWT
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Email (Resend)
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender identity, e.g. "Enginex <no-reply@yourdomain.com>"
EMAIL_FROM="Enginex <onboarding@resend.dev>"

# Email verification OTP (optional — sensible defaults are used if unset)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# AWS S3 image uploads
# Use "database" for the fully local/offline profile-image implementation.
# Use "s3" to preserve the production upload behavior.
STORAGE_PROVIDER=database
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Existing projects may use AWS_BUCKET, AWS_ACCESS_KEY, and AWS_SECRET_KEY instead.
# Optional CDN or public bucket URL, e.g. "https://cdn.example.com"
AWS_S3_PUBLIC_BASE_URL=
